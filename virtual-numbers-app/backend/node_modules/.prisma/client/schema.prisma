generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  password         String
  balance          Float    @default(0)
  role             String   @default("user")
  forwardingNumber String? // user's real phone number for call forwarding
  createdAt        DateTime @default(now())

  numbers  VirtualNumber[]
  calls    CallLog[]
  messages SmsLog[]
}

model VirtualNumber {
  id           String   @id @default(cuid())
  number       String   @unique
  twilioSid    String   @unique
  country      String
  monthlyPrice Float
  active       Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  userId   String
  user     User      @relation(fields: [userId], references: [id])
  calls    CallLog[]
  messages SmsLog[]
}

model CallLog {
  id        String   @id @default(cuid())
  callSid   String   @unique
  direction String // inbound | outbound
  from      String
  to        String
  duration  Int      @default(0)
  status    String
  createdAt DateTime @default(now())

  userId   String
  user     User          @relation(fields: [userId], references: [id])
  numberId String
  number   VirtualNumber @relation(fields: [numberId], references: [id])
}

model PendingPayment {
  id              String   @id @default(cuid())
  merchantTradeNo String   @unique
  prepayId        String?
  userId          String
  amount          Float
  provider        String // stripe | binance
  credited        Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model SmsLog {
  id        String   @id @default(cuid())
  smsSid    String   @unique
  direction String // inbound | outbound
  from      String
  to        String
  body      String
  status    String
  createdAt DateTime @default(now())

  userId   String
  user     User          @relation(fields: [userId], references: [id])
  numberId String
  number   VirtualNumber @relation(fields: [numberId], references: [id])
}
